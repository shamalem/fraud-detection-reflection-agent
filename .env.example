# LLMod.ai (course-issued key, shared across the group - see the course project PDF)
LLMOD_API_KEY=
LLMOD_BASE_URL=https://api.llmod.ai

# Models - must match the course spec exactly
CHAT_MODEL=MB5R2CF-azure/gpt-5.4-mini
EMBED_MODEL=MB5R2CF-azure/text-embedding-3-small

# Supabase (primary transaction database)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TABLE=fraud_dataset

# Pinecone (fraud-policy knowledge vector index)
PINECONE_API_KEY=
PINECONE_INDEX=fraud-agent
RETRIEVAL_TOP_K=5

# Agent loop limits
MAX_PLANNER_ITERATIONS=6
MAX_REFLECTION_CYCLES=3
